# =====================================================================
# DATS Root Directory Security & Protection
# =====================================================================

# Disable directory browsing
Options -Indexes

# Block direct access to hidden files and sensitive dotfiles (e.g., .env, .git)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Specifically block access to environment, SQL dumps, and sensitive file extensions
<FilesMatch "(^#.*#|\.(bak|conf|dist|env|env\..*|fla|in[ci]|log|orig|psd|sh|sql|sw[op]))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

