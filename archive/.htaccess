# Defense-in-depth for the document store: these files are already served directly by Apache
# (the app links straight to them), so this does not restrict reading a known file path — it only
# stops directory listing and stops anything in here from ever running as a script, even if a
# future upload-validation bug let an executable extension through.
Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .inc
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .inc
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "\.(?i:php|php\d?|phtml|phar|pl|py|cgi|sh|bash|exe|inc|asp|aspx)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(?i:php|php\d?|phtml|phar|pl|py|cgi|sh|bash|exe|inc|asp|aspx)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
