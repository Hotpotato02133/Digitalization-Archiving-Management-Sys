# =====================================================================
# DATS Document Store Security Lockdown (archive/)
# Prevent Remote Code Execution (RCE) and Directory Browsing
# =====================================================================

Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
php_flag engine off

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .inc
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .inc

<IfModule mod_authz_core.c>
    <FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|php8|phar|pl|py|cgi|sh|bash|exe|inc)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|php8|phar|pl|py|cgi|sh|bash|exe|inc)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
