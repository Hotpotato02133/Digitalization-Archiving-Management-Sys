# =====================================================================
# Digitalization Archiving Management System (DATS)
# Environment Configuration Template
# 
# Copy this file to .env before deploying:
#   cp .env.example .env
# =====================================================================

# Application Environment: 'production' or 'development'
# In production, default credentials (localhost/root) are strictly disabled.
APP_ENV=production

# Database Configuration (MySQL / MariaDB)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Google Gemini API Key (Server-side OCR & Document Intelligence)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Gemini Model & Rate Limit Overrides
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# GEMINI_RPM_LIMIT=8
# GEMINI_RPD_LIMIT=150

# Optional: Outgoing cURL SSL Verification (1 = enforce, 0 = relax)
# Defaults to 1 in production and 0 in local development
# CURL_SSL_VERIFY=1

